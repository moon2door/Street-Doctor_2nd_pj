  m_Name: 
  m_EditorClassIdentifier: 
  uiText: {fileID: 202996082}
  portal: {fileID: 1142226552}
  stepTexts:
  - "\uC9C0\uAE08\uBD80\uD130 \uC751\uAE09\uCC98\uCE58 \uAD50\uC721\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uBA3C\uC800 \uD658\uC790\uC758 \uC758\uC2DD\uACFC \uD638\uD761 \uC0C1\uD0DC\uB97C
    \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC5B4\uAE68\uB97C \uB450\uB4DC\uB824\uC11C \uD658\uC790\uC758 \uC0C1\uD0DC\uB97C
    \uD655\uC778\uD574 \uBCF4\uC138\uC694."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uC2EC\uC815\uC9C0 \uC0C1\uD0DC\uC784\uC744 \uD655\uC778\uD588\uB2E4\uBA74 \uC8FC\uBCC0
    \uC0AC\uB78C\uC744 \uC9C0\uBAA9\uD558\uC5EC 119 \uC2E0\uACE0\uC640 AED\uB97C
    \uAC00\uC838\uC62C \uAC83\uC744 \uC9C0\uC2DC\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uADFC\uCC98\uC5D0 \uC0DD\uC131\uB41C \uC0AC\uB78C\uB4E4\uC744 \uC190\uAC00\uB77D\uC73C\uB85C
    \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC73C\uBA74 \uAC8C\uC774\uC9C0\uAC00 \uCC39\uB2C8\uB2E4."
  - "\uC6D0\uD558\uB294 1\uBA85\uC744 \uC9C0\uBAA9\uD558\uC5EC \uAC8C\uC774\uC9C0\uB97C
    \uCC44\uC6CC\uC11C \uC9C0\uC2DC\uD558\uC138\uC694."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uC8FC\uBCC0\uC5D0 \uC0AC\uB78C\uC774 \uC5C6\uC744 \uACBD\uC6B0\uB97C \uB300\uBE44\uD574
    \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
  - "119\uC5D0 \uC9C1\uC811 \uC2E0\uACE0\uB97C \uD574\uBCFC\uAE4C\uC694?"
  - "\uC67C\uC190\uC744 \uBCF4\uBA74 \uD734\uB300\uD3F0\uC774 \uC0DD\uC131\uB418\uC5B4
    \uC788\uC2B5\uB2C8\uB2E4. "
  - "119\uC5D0 \uC804\uD654\uD558\uC5EC \uC2E0\uACE0\uD574 \uC8FC\uC138\uC694."
  - "\uC2E0\uACE0\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC774\uC81C CPR \uAD50\uC721\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uAD50\uC721\uC5D0 \uC55E\uC11C CPR\uC744 \uD574\uC57C \uD558\uB294 \uC774\uC720\uB97C
    \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "CPR\uC740 \uC2EC\uC815\uC9C0 \uD658\uC790\uB97C \uC0B4\uB9AC\uB294 \uAC83\uC774
    \uC544\uB2CC, \uD658\uC790\uC758 \uC2DC\uAC04\uC744 \uBC84\uB294 \uD589\uB3D9\uC785\uB2C8\uB2E4."
  - "\uC2EC\uC7A5\uC774 \uBA48\uCD94\uBA74 \uB1CC\uC5D0 \uD608\uB958\uAC00 \uD750\uB974\uC9C0
    \uC54A\uAC8C \uB429\uB2C8\uB2E4."
  - "\uB1CC\uB294 4\uBD84 \uC774\uC0C1 \uD608\uB958\uAC00 \uD750\uB974\uC9C0 \uC54A\uC73C\uBA74
    \uAE09\uACA9\uD788 \uB9DD\uAC00\uC9C0\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uC774 4\uBD84\uC758 \uC2DC\uAC04\uC774 \uBC14\uB85C \uACE8\uB4E0\uD0C0\uC784\uC785\uB2C8\uB2E4."
  - "\uACE8\uB4E0\uD0C0\uC784 \uB0B4\uC5D0 CPR\uC744 \uC9C4\uD589\uD558\uC5EC \uD658\uC790\uC758
    \uB1CC\uC5D0 \uAC15\uC81C\uB85C \uD608\uB958\uAC00 \uD750\uB974\uB3C4\uB85D \uC2EC\uC7A5\uC744
    \uD38C\uD551\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC774\uC81C \uD749\uBD80\uB97C \uC555\uBC15\uD574\uBCFC\uAE4C\uC694?"
  - "\uC190\uC744 \uD658\uC790\uC758 \uC0C1\uCCB4\uC5D0 \uD45C\uC2DC\uB41C \uC704\uCE58\uB85C
    \uC62C\uB824\uC8FC\uC138\uC694."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uD45C\uC2DC\uB41C \uC704\uCE58\uB97C \uAE30\uC900\uC73C\uB85C \uC190\uAC00\uB77D
    \uD55C\uB9C8\uB514 \uBC18 \uC815\uB3C4\uC758 \uAE38\uC774(5cm)\uC758 \uAE4A\uC774\uB85C
    \uD749\uBD80\uB97C \uC555\uBC15\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC2EC\uD3D0\uC18C\uC0DD\uC220 \uC911 \uAD8C\uC7A5 \uD749\uBD80 \uC555\uBC15
    \uD69F\uC218\uB294 \uBD84\uB2F9 100~120\uD68C\uC785\uB2C8\uB2E4. "
  - "1\uBD84 \uB0B4\uC5D0 100\uD68C \uC774\uC0C1\uC758 \uD749\uBD80 \uC555\uBC15\uC744
    \uC2E4\uC2DC\uD558\uC5EC \uC8FC\uC138\uC694."
  - "\uC9C0\uAE08\uBD80\uD130 AED \uC0AC\uC6A9\uBC95 \uC548\uB0B4\uB97C \uC2E4\uC2DC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "AED\uB294 CPR\uB85C \uC720\uC9C0\uB418\uB294 \uC778\uACF5 \uC21C\uD658 \uC911,
    \uC2EC\uC7A5\uC758 \uBD88\uADDC\uCE59\uD55C \uB9AC\uB4EC\uC744 \uAC10\uC9C0\uD558\uBA74
    \uC804\uAE30 \uCDA9\uACA9\uC73C\uB85C \uB9AC\uB4EC\uC744  \uCD08\uAE30\uD654\uD574
    \uC815\uC0C1 \uC2EC\uC7A5 \uBC15\uB3D9\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uAE30 \uC704\uD574
    \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
  - "AED\uB97C \uC0AC\uC6A9\uD558\uAE30 \uC704\uD574\uC120 \uD658\uC790\uC758 \uC0C1\uC758\uB97C
    \uBC97\uACA8\uC57C \uD569\uB2C8\uB2E4. "
  - "\uD658\uC790\uC758 \uC0C1\uBC18\uC2E0\uC744 \uD074\uB9AD\uD574 \uC0C1\uC758\uB97C
    \uBC97\uAE30\uC138\uC694."
  - "AED\uC758 \uB69C\uAED1 \uC5F4\uAE30 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC
    \uB69C\uAED1\uC744 \uC5EC\uC138\uC694."
  - "\uCD08\uB85D\uC0C9 \uC2DC\uC791 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD574 \uC8FC\uC138\uC694."
  - "\uC131\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uB354\uBBF8\uC5D0 \uB9DE\uB294
    \uCCB4\uD615\uC744 \uC120\uD0DD\uD558\uC138\uC694."
  - "\uD328\uB4DC\uB97C \uC7A1\uC544 \uD658\uC790\uC758 \uC0C1\uBC18\uC2E0\uC5D0
    \uD45C\uC2DC\uB41C \uC704\uCE58\uC5D0 \uB193\uC73C\uBA74 \uBD80\uCC29\uC774 \uB429\uB2C8\uB2E4."
  - "\uC9C0\uC2DC\uC5D0 \uB530\uB77C \uCDA9\uACA9 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uC751\uAE09\uCC98\uCE58 \uD6C8\uB828\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
  - "\uC774\uC81C \uC2E4\uC804 \uD658\uACBD\uC5D0\uC11C \uC751\uAE09\uCC98\uCE58\uB97C
    \uC9C4\uD589\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uBAA8\uB4DC\uB97C \uC120\uD0DD\uD560 \uC218
    \uC788\uB294 UI\uAC00 \uC0DD\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4. "
  - "\uBA40\uD2F0\uC640 \uC2F1\uAE00 \uBAA8\uB4DC \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC5EC
    \uC2E4\uC804 \uC2A4\uD14C\uC774\uC9C0\uB85C \uC774\uB3D9\uD574 \uC8FC\uC138\uC694."
