--- !u!114 &1851328729
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1851328728}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2521c5daa79df8449a25fdcdc62e459, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiText: {fileID: 202996082}
  portal: {fileID: 1142226552}
  stepTexts:
  - "\uC9C0\uAE08\uBD80\uD130 CPR \uC751\uAE09\uCC98\uCE58 \uAD50\uC721\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uBA3C\uC800 \uD658\uC790\uC758 \uC758\uC2DD\uACFC \uD638\uD761 \uC0C1\uD0DC\uB97C
    \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC5B4\uAE68\uB97C \uB450\uB4DC\uB9AC\uBA70 \uD070\uC18C\uB9AC\uB85C \uAD1C\uCC2E\uC740\uC9C0
    \uC758\uC2DD\uC744 \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uD638\uD761\uC774 \uC5C6\uAC70\uB098 \uBD88\uC548\uC815\uD558\uB2E4\uBA74 CPR\uC744
    \uC900\uBE44\uD574\uC57C \uD569\uB2C8\uB2E4. \uC8FC\uBCC0 \uC0AC\uB78C\uC744
    \uC9C0\uBAA9\uD558\uC5EC 119\uC2E0\uACE0 \uBC0F AED\uB97C \uAC00\uC838\uC62C
    \uAC83\uC744 \uC694\uCCAD\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC8FC\uBCC0 \uC0AC\uB78C\uC744 \uC9C0\uBAA9\uD560\uB54C\uB294 \uBA85\uD655
    \uD574\uC57C\uD569\uB2C8\uB2E4. \uC608\uB97C \uB4E4\uC5B4 \"\uC55E\uC5D0 \uD558\uB298\uC0C9
    \uD2F0\uC154\uCE20\uB97C \uC785\uACE0 \uACC4\uC2E0 \uB0A8\uC790\uBD84.\"\uB4F1\uC758
    \uD2B9\uC815 \uB300\uC0C1\uC744 \uC9C0\uBAA9\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uADFC\uCC98\uC5D0 \uC0DD\uC131\uB41C \uC0AC\uB78C\uB4E4 \uC911 \uD55C\uBA85\uC744
    \uC190\uAC00\uB77D\uC73C\uB85C \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC73C\uBA74 \uAC8C\uC774\uC9C0\uAC00
    \uCC30\uAC83\uC785\uB2C8\uB2E4. \uAC8C\uC774\uC9C0\uB97C \uCC44\uC6CC\uC11C \uC694\uCCAD\uD558\uC138\uC694."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uC8FC\uBCC0\uC5D0 \uC0AC\uB78C\uC774 \uC5C6\uC744 \uACBD\uC6B0\uB97C \uB300\uBE44\uD574
    \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
  - "119\uC5D0 \uC9C1\uC811 \uC2E0\uACE0\uB97C \uD574\uBCFC\uAE4C\uC694?"
  - "\uC67C\uC190\uC744 \uBCF4\uBA74 \uD734\uB300\uD3F0\uC774 \uC0DD\uC131\uB418\uC5B4
    \uC788\uC2B5\uB2C8\uB2E4. "
  - "\uAE34\uAE09\uD1B5\uD654 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 119\uC5D0 \uC2E0\uACE0\uAC00
    \uB429\uB2C8\uB2E4."
  - "\uC2E0\uACE0\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC774\uC81C CPR(\uC2EC\uD3D0\uC18C\uC0DD\uC220) \uAD50\uC721\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uAD50\uC721\uC5D0 \uC55E\uC11C CPR\uC744 \uD574\uC57C \uD558\uB294 \uC774\uC720\uB97C
    \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "CPR\uC740 \uC2EC\uC7A5\uC744 \uB2E4\uC2DC \uB6F0\uAC8C \uD558\uB294 \uAC83\uC774
    \uC544\uB2C8\uB77C, \uC2EC\uC7A5\uC758 \uC5ED\uD560\uC744 \uB300\uC2E0\uD574
    \uC8FC\uB294 \uD589\uB3D9\uC785\uB2C8\uB2E4."
  - "\uC2EC\uC7A5\uC774 \uBA48\uCD94\uBA74 \uD608\uC561\uC21C\uD658\uC774 \uBA48\uCD94\uACE0
    \uB1CC\uC5D0\uB3C4 \uD608\uB958\uAC00 \uD750\uB974\uC9C0 \uC54A\uAC8C \uB429\uB2C8\uB2E4."
  - "\uC21C\uD658\uC774 \uBA48\uCDB0 4\uBD84\uC774\uC0C1 \uB1CC\uC5D0 \uC0B0\uC18C\uAC00
    \uACF5\uAE09\uB418\uC9C0 \uC54A\uC73C\uBA74 \uB1CC\uAC00 \uC190\uC0C1\uB418\uAE30
    \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uC774 4\uBD84\uC758 \uC2DC\uAC04\uC774 \uBC14\uB85C \uACE8\uB4E0\uD0C0\uC784\uC785\uB2C8\uB2E4."
  - "\uACE8\uB4E0\uD0C0\uC784 \uB0B4\uC5D0 CPR\uC744 \uC9C4\uD589\uD558\uC5EC \uD658\uC790\uC758
    \uB1CC\uC5D0 \uC0B0\uC18C\uAC00 \uACF5\uAE09\uB418\uB3C4\uB85D \uC2EC\uC7A5\uC744
    \uD38C\uD551\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "CPR\uC740 \uD55C\uCABD \uC190\uB4F1\uC704\uC5D0 \uB2E4\uB978\uCABD \uC190\uBC14\uB2E5\uC744
    \uC5B9\uC5B4 \uAE4D\uC9C0\uB97C \uB07C\uACE0 \uC544\uB798\uCABD \uC190\uAC00\uB77D\uC744
    \uC704\uB85C \uC816\uD78C \uC0C1\uD0DC\uC5D0\uC11C \uC9C4\uD589\uD569\uB2C8\uB2E4."
  - "\uD658\uC790\uC758 \uC0C1\uCCB4 \uD45C\uC2DC\uB41C \uC704\uCE58\uC5D0 \uC190\uBC14\uB2E5
    \uB4B7\uAFC8\uCE58\uB97C \uC62C\uB824\uC8FC\uC138\uC694. \uD45C\uC2DC\uB41C \uC704\uCE58\uB294
    \uD658\uC790\uC758 \uAC00\uC2B4\uBF08(\uD749\uACE8) \uC544\uB798\uCABD \uC808\uBC18\uBD80\uC704\uC785\uB2C8\uB2E4."
  - "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "CPR\uC744 \uC9C4\uD589\uD560\uB54C\uB294 \uC5C9\uB369\uC774\uB97C \uB4E4\uACE0
    \uB450\uD314\uC744 \uACE7\uAC8C \uD3B4\uC11C \uC9C0\uBA74\uACFC \uC218\uC9C1\uC774
    \uB418\uB3C4\uB85D \uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uB610\uD55C, CPR\uC740 5cm\uC758 \uAE4A\uC774\uB85C \uC555\uBC15\uD574\uC57C
    \uD569\uB2C8\uB2E4. \uAC00\uC2B4\uBF08\uC640 \uAC08\uBE44\uBF08\uB97C 5cm\uB098
    \uB204\uB974\uB294 \uAC83\uC774\uB2C8 \uB9CC\uD07C \uD070 \uD798\uC73C\uB85C
    \uB20C\uB7EC\uC57C \uD569\uB2C8\uB2E4."
  - "CPR\uC758 \uAD8C\uC7A5 \uD749\uBD80 \uC555\uBC15 \uD69F\uC218\uB294 \uBD84\uB2F9
    100~120\uD68C \uC785\uB2C8\uB2E4. \uC18D\uB3C4\uC5D0 \uB9DE\uCDB0 30\uD68C\uB97C
    \uC2E4\uC2DC\uD574 \uC8FC\uC138\uC694."
  - "\uC9C0\uAE08\uBD80\uD130\uB294 AED \uC0AC\uC6A9\uBC95\uC744 \uC548\uB0B4\uD574
    \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "AED\uB294 \uC790\uB3D9 \uC2EC\uC7A5\uCDA9\uACA9\uAE30\uB85C \uC2EC\uC7A5\uC758
    \uBD88\uADDC\uCE59\uD55C \uB9AC\uB4EC\uC744 \uAC10\uC9C0\uD574 \uC804\uAE30 \uCDA9\uACA9\uC73C\uB85C
    \uC815\uC0C1 \uC2EC\uC7A5 \uBC15\uB3D9\uC744 \uD68C\uBCF5 \uC2DC\uD0A4\uAE30
    \uC704\uD574 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
  - "AED\uB97C \uC0AC\uC6A9\uD558\uAE30 \uC704\uD574 \uD658\uC790\uC758 \uC0C1\uC758\uB294
    \uC644\uC804\uD788 \uC81C\uAC70\uB418\uC57C \uD569\uB2C8\uB2E4."
  - "\uD658\uC790\uC758 \uC0C1\uBC18\uC2E0\uC744 \uD074\uB9AD\uD574 \uC0C1\uC758\uB97C
    \uBC97\uAE30\uC138\uC694."
  - "\uB610\uD55C AED\uB97C \uC0AC\uC6A9\uD568\uC5D0 \uC788\uC5B4 \uBAB8\uC5D0 \uB540\uC774\uB098
    \uC774\uBB3C\uC9C8\uC774 \uB0A8\uC544 \uC788\uB2E4\uBA74 \uAC10\uC804\uC758 \uC704\uD5D8\uC131\uC774
    \uC874\uC7AC\uD569\uB2C8\uB2E4. \uBC18\uB4DC\uC2DC \uC81C\uAC70\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC774\uC81C \uC624\uB978\uCABD\uC744 \uBCF4\uC2DC\uBA74 AED\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
  - "AED\uC758 \uB69C\uAED1 \uC5F4\uAE30 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC
    \uB69C\uAED1\uC744 \uC5F4\uC5B4 \uC8FC\uC138\uC694."
  - "\uCD08\uB85D\uC0C9 \uC804\uC6D0 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
  - "\uB69C\uAED1\uC5D0 \uBD99\uC5B4\uC788\uB294 \uD328\uB4DC\uB97C \uC7A1\uC544
    \uD658\uC790\uC758 \uC0C1\uBC18\uC2E0\uC5D0 \uD45C\uC2DC\uB41C \uC704\uCE58\uC5D0
    \uB193\uC73C\uBA74 \uBD80\uCC29\uB429\uB2C8\uB2E4."
  - "\uB450 \uAC1C\uC758 \uD328\uB4DC \uC911  \uD558\uB098\uB294 \uC624\uB978\uCABD
    \uC1C4\uACE8 \uC544\uB798 \uB610 \uD558\uB098\uB294 \uC67C\uCABD \uC816\uAF2D\uC9C0
    \uC544\uB798 \uC911\uAC04 \uACA8\uB4DC\uB791\uC774\uC120\uC5D0 \uBD80\uCC29\uD569\uB2C8\uB2E4."
  - "\uD328\uB4DC\uB97C \uBD80\uCC29\uD558\uBA74 AED\uAC00 \uD658\uC790\uC758 \uC2EC\uC804\uB3C4\uB97C
    \uBD84\uC11D\uD569\uB2C8\uB2E4. AED\uAC00 \uD544\uC694\uD55C \uC0C1\uD669\uC778\uC9C0\uB97C
    \uBD84\uC11D\uD558\uB294 \uACFC\uC815\uC785\uB2C8\uB2E4."
  - "\uD658\uC790\uC758 \uB9AC\uB4EC\uC744 \uBD84\uC11D\uD558\uB294 \uB3D9\uC548
    \uD658\uC790\uB97C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB3C4\uB85D \uACC1\uC5D0\uC11C
    \uB5A8\uC5B4\uC838\uC57C \uD569\uB2C8\uB2E4. \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4
    \uD070 \uC18C\uB9AC\uB85C \"\uB5A8\uC5B4\uC9C0\uC138\uC694\" \uB77C\uACE0 \uC54C\uB824\uC57C
    \uD569\uB2C8\uB2E4."
  - "\uBD84\uC11D \uD6C4 \uC2EC\uC7A5\uCDA9\uACA9\uC774 \uD544\uC694\uD55C \uACBD\uC6B0
    \uC54C\uB9BC\uC774 \uC6B8\uB9B0 \uD6C4 \uCDA9\uC804\uC5D0 \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.
    \uCDA9\uC804\uC740 10~20\uCD08 \uC815\uB3C4 \uAC78\uB9AC\uACE0 \uCDA9\uC804\uC774
    \uB418\uB294\uB3D9\uC548 \uB2E4\uC2DC CPR\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4."
  - "\uCDA9\uC804\uC774 \uC644\uB8CC \uB418\uBA74 \uB2E4\uC2DC \uD55C\uBC88 \uC8FC\uBCC0
    \uC0AC\uB78C\uB4E4\uC758 \uC811\uCD09 \uAE08\uC9C0\uB97C \uD655\uC778 \uD55C
    \uD6C4 \uC9C0\uC2DC\uC5D0 \uB530\uB77C \uCDA9\uACA9\uBC84\uD2BC\uC744 \uB20C\uB7EC\uC57C
    \uD569\uB2C8\uB2E4."
  - "\uCDA9\uACA9 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
  - "\uAD6C\uAE09\uCC28\uAC00 \uB3C4\uCC29\uD558\uAC70\uB098 \uD658\uC790\uC758 \uC758\uC2DD\uC774
    \uAE68\uC5B4\uB0A0 \uB54C \uAE4C\uC9C0 \uC55E\uC11C \uBC30\uC6B4 CPR\uACFC AED\uC758
    \uACFC\uC815\uC744 \uBC18\uBCF5\uD574\uC11C \uC2E4\uC2DC\uD574\uC57C \uD569\uB2C8\uB2E4."
  - "\uC790. \uC774\uC81C \uC751\uAE09\uCC98\uCE58 \uD6C8\uB828\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
  - "\uC774\uC81C \uC2E4\uC804 \uD658\uACBD\uC5D0\uC11C \uC751\uAE09\uCC98\uCE58
    \uC0C1\uD669\uC774 \uC0DD\uACBC\uC744 \uB54C\uB97C \uB300\uBE44\uD574 \uBCFC\uAE4C\uC694?"
  - "\uC6B0\uCE21 \uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uBAA8\uB4DC\uB97C \uC120\uD0DD\uD560
    \uC218 \uC788\uB294 UI\uAC00 \uC0DD\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4. "
  - "\uBA40\uD2F0\uC640 \uC2F1\uAE00 \uBAA8\uB4DC \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD558\uC5EC
    \uC2E4\uC804 \uC2A4\uD14C\uC774\uC9C0\uB85C \uC774\uB3D9\uD574 \uC8FC\uC138\uC694."
